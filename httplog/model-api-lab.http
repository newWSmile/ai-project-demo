### 测试普通对话
# 用途：验证 Spring AI 能通过 DashScope OpenAI-compatible API 完成一次非流式模型调用，并返回 Token 与总耗时。
POST http://localhost:8080/api/chat
Content-Type: application/json; charset=UTF-8
Accept: application/json

{
  "message": "请用三句话解释什么是大语言模型"
}

### 测试流式输出
# 用途：验证 SSE 流式响应，观察模型内容分块返回，并检查中文 UTF-8 编码是否正常。
POST http://localhost:8080/api/chat/stream
Content-Type: application/json; charset=UTF-8
Accept: text/event-stream

{
  "message": "请分五点介绍Java开发者学习AI应用开发的优势"
}

> {%
// 回归断言：该接口曾出现 IDEA HTTP Client 中文乱码，仅检查异常相关的 UTF-8 响应头。
client.test("SSE 响应声明 UTF-8", function () {
    const contentType = response.headers.valuesOf("Content-Type")[0] || "";
    client.assert(
        contentType.toLowerCase().includes("charset=utf-8"),
        "预期 Content-Type 包含 charset=UTF-8，实际为：" + contentType
    );
});
%}

### 测试 Java 21 原生 HttpClient 对话
# 用途：绕过 Spring AI，验证 JDK HttpClient 能直接组装 OpenAI-compatible 请求并调用 DashScope，同时返回 Usage 与总耗时。
POST http://localhost:8080/api/chat/raw
Content-Type: application/json; charset=UTF-8
Accept: application/json

{
  "message": "请用三句话解释 Java 原生 HttpClient 调用大模型需要处理哪些事情"
}


### 测试 Java 21 原生 HttpClient 对话跟ai的同样输入
# 用途：绕过 Spring AI，验证 JDK HttpClient 能直接组装 OpenAI-compatible 请求并调用 DashScope，同时返回 Usage 与总耗时。
POST http://localhost:8080/api/chat/raw
Content-Type: application/json; charset=UTF-8
