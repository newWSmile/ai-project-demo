# 仅用于配置项参考；Spring Boot 和 Python 服务都不会自动加载该文件。
# 启动服务前，请在当前终端或 IDE 私有运行配置中设置这些环境变量。
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_TEMPERATURE=0.2

# Python Client 使用完整的 chat/completions 地址。
MODEL_CHAT_COMPLETIONS_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Python 命令行实验调用本地 Java 服务时使用。
LAB_SERVICE_URL=http://localhost:8080
