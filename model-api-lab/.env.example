# Copy this file to .env for reference. Spring Boot does not load .env automatically.
# Set these variables in the terminal before starting the application.
MODEL_API_KEY=replace-with-your-api-key
MODEL_BASE_URL=https://api.openai.com
MODEL_NAME=gpt-5-mini
MODEL_TEMPERATURE=0.2

# Used only by python/direct_model_call.py.
MODEL_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions

# Local Java service URL used by python/call_java_service.py.
LAB_SERVICE_URL=http://localhost:8080

